
import { getDb } from "@/lib/db"
import { requireAdmin } from "@/lib/server-auth"

const sql = getDb()

export async function GET() {
  try {
    const attendance = await sql`
      SELECT
        id,
        student_id,
        attendance_date,
        status,
        remarks,
        academic_year,
        term,
        created_at
      FROM attendance
      ORDER BY attendance_date DESC, id DESC
    `

    return Response.json({
      success: true,
      attendance,
    })
  } catch (error) {
    console.error("Failed to fetch attendance:", error)

    return Response.json(
      {
        success: false,
        error: "Failed to fetch attendance",
      },
      { status: 500 }
    )
  }
}

export async function POST(request: Request) {
  const auth = await requireAdmin()

  if (!auth.authorized) {
    return auth.response
  }

  try {
    const body = await request.json()

    const studentId = body.studentId ?? body.student_id
    const attendanceDate = body.date ?? body.attendance_date
    const status = body.status
    const remarks = body.remarks ?? ""

    if (!studentId || !attendanceDate || !status) {
      return Response.json(
        {
          success: false,
          error: "studentId, date and status are required",
        },
        { status: 400 }
      )
    }

    // Get the currently active academic term
    const currentTermResult = await sql`
      SELECT
        academic_year,
        term
      FROM academic_terms
      WHERE status = 'Current'
      ORDER BY academic_year DESC, start_date DESC
      LIMIT 1
    `

    if (currentTermResult.length === 0) {
      return Response.json(
        {
          success: false,
          error: "No current academic term has been configured",
        },
        { status: 400 }
      )
    }

    const academicYear = currentTermResult[0].academic_year
    const term = currentTermResult[0].term

    const result = await sql`
      INSERT INTO attendance (
        student_id,
        attendance_date,
        status,
        remarks,
        academic_year,
        term
      )
      VALUES (
        ${studentId},
        ${attendanceDate},
        ${status},
        ${remarks},
        ${academicYear},
        ${term}
      )
      RETURNING
        id,
        student_id,
        attendance_date,
        status,
        remarks,
        academic_year,
        term,
        created_at
    `

    return Response.json({
      success: true,
      attendance: result[0],
    })
  } catch (error) {
    console.error("Failed to save attendance:", error)

    return Response.json(
      {
        success: false,
        error: "Failed to save attendance",
      },
      { status: 500 }
    )
  }
}
